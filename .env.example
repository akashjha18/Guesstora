MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Remove or comment out MYSQL_DATABASE when using MYSQL_URL below.
MYSQL_DATABASE=cafe_loyalty
# Or, instead of the four vars above, a single connection string:
# MYSQL_URL=mysql://user:password@127.0.0.1:3306/cafe_loyalty
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
# Set this to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
DEMO_PAYMENTS_ENABLED=false
# Configure only the payment gateways you enable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
